func Test{{.Name}}Validation(t *testing.T) {
	c, _ := newClient(t)
	tests := []struct {
		name   string
		mutate func(*pb.{{.Name}})
		field  string
	}{
{{- range .Invalid}}
		{ {{- printf "%q" .Name}}, func(x *pb.{{$e.Name}}) { x.{{.GoName}} = {{.Expr}} }, {{printf "%q" .Field -}} },
{{- end}}
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			x := valid{{.Name}}(0)
			tt.mutate(x)
			_, err := c.Create{{.Name}}(t.Context(), &pb.Create{{.Name}}Request{ {{.GoField}}: x})
			wantViolation(t, err, "{{.Snake}}."+tt.field)
		})
	}
	_, err := c.Create{{.Name}}(t.Context(), &pb.Create{{.Name}}Request{})
	wantCode(t, err, codes.InvalidArgument)
}

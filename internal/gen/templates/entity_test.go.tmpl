// Test{{.Name}}Boundaries checks that values exactly at each limit are
// accepted: off-by-one mistakes in the rules show up here.
func Test{{.Name}}Boundaries(t *testing.T) {
	c, _ := newClient(t)
	tests := []struct {
		name   string
		mutate func(*pb.{{.Name}})
	}{
{{- range .Boundary}}
		{ {{- printf "%q" .Name}}, func(x *pb.{{$e.Name}}) { x.{{.GoName}} = {{.Expr}} } },
{{- end}}
	}
	for i, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			x := valid{{.Name}}(i + 1)
			tt.mutate(x)
			if _, err := c.Create{{.Name}}(t.Context(), &pb.Create{{.Name}}Request{ {{.GoField}}: x}); err != nil {
				t.Fatalf("a value at the limit was rejected: %v", err)
			}

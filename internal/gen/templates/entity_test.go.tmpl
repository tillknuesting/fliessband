// valid{{.Name}} returns a {{.Lower}} that passes validation; i varies unique fields.
func valid{{.Name}}(i int) *pb.{{.Name}} {
	return &pb.{{.Name}}{
{{- range .Fields}}
		{{.GoName}}: {{.ValidExpr}},
{{- end}}
	}
}

// seed{{.Name}} stores valid{{.Name}}(i) and returns the stored copy.
func seed{{.Name}}(t *testing.T, c pb.{{$.ServiceName}}Client, st *store.Memory, i int) *pb.{{.Name}} {
	t.Helper()
{{- if .HasCreate}}
	resp, err := c.Create{{.Name}}(t.Context(), &pb.Create{{.Name}}Request{ {{.GoField}}: valid{{.Name}}(i)})
	if err != nil {
		t.Fatalf("seed: %v", err)
	}
	return resp.Get{{.GoField}}()
{{- else}}
	x := valid{{.Name}}(i)
	x.Id = fmt.Sprintf("seed-%d", i)
	x.CreateTime = timestamppb.New(time.Now())
	x.UpdateTime = x.CreateTime
	created, err := st.Create{{.Name}}(t.Context(), x)
	if err != nil {
		t.Fatalf("seed: %v", err)
	}
	return created
{{- end}}
}

func Test{{.Name}}Lifecycle(t *testing.T) {
	c, st := newClient(t)
	x := seed{{.Name}}(t, c, st, 0)
	if x.GetId() == "" || x.GetCreateTime() == nil || x.GetUpdateTime() == nil {
		t.Fatalf("server-set fields missing: %v", x)
	}
{{- if .HasGet}}

	t.Run("get", func(t *testing.T) {
		got, err := c.Get{{.Name}}(t.Context(), &pb.Get{{.Name}}Request{Id: x.GetId()})
		if err != nil {
			t.Fatalf("get: %v", err)
		}
		if !proto.Equal(got.Get{{.GoField}}(), x) {
			t.Fatalf("get = %v, want %v", got.Get{{.GoField}}(), x)
		}
		_, err = c.Get{{.Name}}(t.Context(), &pb.Get{{.Name}}Request{Id: "missing"})
		wantCode(t, err, codes.NotFound)
		_, err = c.Get{{.Name}}(t.Context(), &pb.Get{{.Name}}Request{})
		wantCode(t, err, codes.InvalidArgument)
	})
{{- end}}
{{- if and .HasUpdate .Update}}

	t.Run("update", func(t *testing.T) {
		upd, err := c.Update{{.Name}}(t.Context(), &pb.Update{{.Name}}Request{
			{{.GoField}}:  &pb.{{.Name}}{Id: x.GetId(), {{.Update.Field.GoName}}: {{.Update.Expr}}},
			UpdateMask: &fieldmaskpb.FieldMask{Paths: []string{"{{.Update.Field.Name}}"}},
		})
		if err != nil {
			t.Fatalf("update: %v", err)
		}
{{- if .Update.Equals}}
		if got := upd.Get{{.GoField}}().Get{{.Update.Field.GoName}}(); got != {{.Update.Expr}} {
			t.Fatalf("{{.Update.Field.Name}} = %v after update, want %v", got, {{.Update.Expr}})
		}
{{- else}}
		if upd.Get{{.GoField}}().GetId() != x.GetId() {
			t.Fatalf("update returned id %q, want %q", upd.Get{{.GoField}}().GetId(), x.GetId())
		}
{{- end}}
		full := valid{{.Name}}(0)
		full.Id = x.GetId()
		if _, err := c.Update{{.Name}}(t.Context(), &pb.Update{{.Name}}Request{ {{.GoField}}: full}); err != nil {
			t.Fatalf("update with empty mask: %v", err)
		}
		_, err = c.Update{{.Name}}(t.Context(), &pb.Update{{.Name}}Request{
			{{.GoField}}:  &pb.{{.Name}}{Id: x.GetId()},
			UpdateMask: &fieldmaskpb.FieldMask{Paths: []string{"id"}},
		})
		wantCode(t, err, codes.InvalidArgument)
		_, err = c.Update{{.Name}}(t.Context(), &pb.Update{{.Name}}Request{ {{.GoField}}: &pb.{{.Name}}{Id: "missing"}})
		wantCode(t, err, codes.NotFound)
		_, err = c.Update{{.Name}}(t.Context(), &pb.Update{{.Name}}Request{})
		wantCode(t, err, codes.InvalidArgument)
	})
{{- end}}
{{- if .HasDelete}}

	t.Run("delete", func(t *testing.T) {
		if _, err := c.Delete{{.Name}}(t.Context(), &pb.Delete{{.Name}}Request{Id: x.GetId()}); err != nil {
			t.Fatalf("delete: %v", err)
		}
		_, err := c.Delete{{.Name}}(t.Context(), &pb.Delete{{.Name}}Request{Id: x.GetId()})
		wantCode(t, err, codes.NotFound)
		_, err = c.Delete{{.Name}}(t.Context(), &pb.Delete{{.Name}}Request{})
		wantCode(t, err, codes.InvalidArgument)
	})
{{- end}}
}

func Test{{.Name}}Pagination(t *testing.T) {
	c, st := newClient(t)
	const n = 5
	for i := range n {
		seed{{.Name}}(t, c, st, i)
	}
	seen, token := 0, ""
	for page := 0; ; page++ {
		resp, err := c.List{{.Plural}}(t.Context(), &pb.List{{.Plural}}Request{PageSize: 2, PageToken: token})
		if err != nil {
			t.Fatalf("list page %d: %v", page, err)
		}
		if got := len(resp.Get{{.GoPluralField}}()); got > 2 || (page == 0 && got != 2) {
			t.Fatalf("page %d has %d {{.PluralLower}}, want 2 per page", page, got)
		}
		seen += len(resp.Get{{.GoPluralField}}())
		if token = resp.GetNextPageToken(); token == "" {
			break
		}
		if page > n {
			t.Fatal("pagination does not terminate")
		}
	}
	if seen != n {
		t.Fatalf("listed %d {{.PluralLower}}, want %d", seen, n)
	}
	all, err := c.List{{.Plural}}(t.Context(), &pb.List{{.Plural}}Request{})
	if err != nil || len(all.Get{{.GoPluralField}}()) != n || all.GetNextPageToken() != "" {
		t.Fatalf("page_size 0 must use the default page size: %d {{.PluralLower}}, token %q, %v", len(all.Get{{.GoPluralField}}()), all.GetNextPageToken(), err)
	}
	_, err = c.List{{.Plural}}(t.Context(), &pb.List{{.Plural}}Request{PageSize: -1})
	wantViolation(t, err, "page_size")
	_, err = c.List{{.Plural}}(t.Context(), &pb.List{{.Plural}}Request{PageToken: "!!"})
	wantViolation(t, err, "page_token")
}

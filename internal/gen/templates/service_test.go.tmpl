func TestToStatus(t *testing.T) {
	s := New(store.NewMemory(), slog.New(slog.DiscardHandler))
	tests := []struct {
		err  error
		want codes.Code
	}{
		{fmt.Errorf("x: %w", store.ErrNotFound), codes.NotFound},
		{fmt.Errorf("x: %w", store.ErrAlreadyExists), codes.AlreadyExists},
		{context.Canceled, codes.Canceled},
		{context.DeadlineExceeded, codes.DeadlineExceeded},
		{status.Error(codes.FailedPrecondition, "x"), codes.FailedPrecondition},
		{errors.New("boom"), codes.Internal},
	}
	for _, tt := range tests {
		if got := status.Code(s.toStatus(t.Context(), tt.err)); got != tt.want {
			t.Errorf("toStatus(%v) = %v, want %v", tt.err, got, tt.want)
		}
	}
}

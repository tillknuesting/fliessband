func TestPageTokens(t *testing.T) {
	for _, id := range []string{"a", "0190a6b4-6d1c-7c3e-9f00-1234567890ab", strings.Repeat("x", maxTokenID)} {
		got, err := decodePageToken(encodePageToken(id))
		if err != nil || got != id {
			t.Fatalf("round trip %q: got %q, %v", id, got, err)
		}
	}
	raw := func(s string) string { return base64.RawURLEncoding.EncodeToString([]byte(s)) }
	for _, bad := range []string{"!!", raw("x1"), raw("k"), raw("k" + strings.Repeat("a", maxTokenID+1)), "a\r00"} {
		if _, err := decodePageToken(bad); err == nil {
			t.Errorf("decodePageToken(%q) succeeded, want error", bad)
		}
	}
{{- with index .Entities 0}}

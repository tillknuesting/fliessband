// Fuzz targets state properties that must hold for any input. go test runs
// their seed corpus; the factory's fuzz stage also explores new inputs, and
// so does "go test -fuzz=FuzzName".
{{- if .AnyList}}

// FuzzPageToken: decoding never panics, rejects every token it did not
// issue, and round-trips every token it did.
func FuzzPageToken(f *testing.F) {
	f.Add(encodePageToken("0190a6b4-6d1c-7c3e-9f00-1234567890ab"))
	f.Add("")
	f.Add("!!")
	f.Add("aw")
	f.Add("a\r00") // found by fuzzing: the base64 decoder skips line breaks
	f.Fuzz(func(t *testing.T, token string) {
		after, err := decodePageToken(token)
		if err != nil {
			return
		}
		if again := encodePageToken(after); again != token {
			t.Fatalf("token %q decodes to %q, which encodes to %q", token, after, again)
		}
	})
}

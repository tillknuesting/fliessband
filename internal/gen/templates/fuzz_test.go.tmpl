// FuzzValidate{{.Name}}: validation never panics and either accepts the
// {{.Lower}} or returns InvalidArgument with at least one field violation.
func FuzzValidate{{.Name}}(f *testing.F) {
	f.Add("", int64(0))
	f.Add("x", int64(-1))
	f.Add("\xff\xfe", int64(1<<40))
	f.Fuzz(func(t *testing.T, s string, n int64) {
		m := valid{{.Name}}(0)
{{- range .Fields}}{{if not .Repeated}}{{if eq .Type "string"}}
		m.{{.GoName}} = s
{{- else if eq .Type "int32"}}
		m.{{.GoName}} = int32(n)
{{- else if eq .Type "int64"}}
		m.{{.GoName}} = n
{{- end}}{{end}}{{end}}
		err := validate{{.Name}}(m, "{{.Snake}}.")
		if err == nil {
			return
		}
		st, _ := status.FromError(err)
		if st.Code() != codes.InvalidArgument || len(st.Details()) == 0 {
			t.Fatalf("validate{{.Name}} returned %v, want InvalidArgument with field violations", err)
		}
	})
}
{{- end}}{{end}}

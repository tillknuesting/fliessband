func TestLogging(t *testing.T) {
	var buf bytes.Buffer
	h := Logging(slog.New(slog.NewJSONHandler(&buf, nil)))
	for _, want := range []error{nil, status.Error(codes.NotFound, "x"), status.Error(codes.Internal, "x")} {
		_, err := h(t.Context(), nil, &grpc.UnaryServerInfo{FullMethod: "/x/Y"},
			func(context.Context, any) (any, error) { return "ok", want })
		if status.Code(err) != status.Code(want) {
			t.Fatalf("got %v, want %v", err, want)
		}
	}
	if n := strings.Count(buf.String(), "\n"); n != 3 {
		t.Fatalf("got %d log lines, want 3:\n%s", n, buf.String())
	}
	for _, lvl := range []string{`"level":"INFO"`, `"level":"WARN"`, `"level":"ERROR"`} {
		if !strings.Contains(buf.String(), lvl) {
			t.Errorf("missing %s in logs", lvl)
		}
	}
}
func TestDeadline(t *testing.T) {
	h := Deadline(time.Minute)
	_, _ = h(t.Context(), nil, nil, func(ctx context.Context, _ any) (any, error) {
		if _, ok := ctx.Deadline(); !ok {
			t.Error("call without deadline did not get one")
		}
		return nil, nil
	})
	_, _ = Deadline(0)(t.Context(), nil, nil, func(ctx context.Context, _ any) (any, error) {
		if _, ok := ctx.Deadline(); ok {
			t.Error("Deadline(0) must not add a deadline")
		}
		return nil, nil
	})
	ctx, cancel := context.WithTimeout(t.Context(), time.Hour)
	defer cancel()
	want, _ := ctx.Deadline()
	_, _ = h(ctx, nil, nil, func(ctx context.Context, _ any) (any, error) {
		if got, _ := ctx.Deadline(); !got.Equal(want) {
			t.Errorf("client deadline changed from %v to %v", want, got)
		}
		return nil, nil
	})
}

func TestLimit(t *testing.T) {
	h := Limit(1)
	started, release := make(chan struct{}), make(chan struct{})
	done := make(chan error)
	go func() {
		_, err := h(t.Context(), nil, nil, func(context.Context, any) (any, error) {
			close(started)
			<-release
			return nil, nil
		})
		done <- err
	}()
	<-started
	_, err := h(t.Context(), nil, nil, func(context.Context, any) (any, error) { return nil, nil })
	if status.Code(err) != codes.ResourceExhausted {
		t.Fatalf("second call: got %v, want ResourceExhausted", err)
	}
	close(release)
	if err := <-done; err != nil {
		t.Fatal(err)
	}
	if _, err := h(t.Context(), nil, nil, func(context.Context, any) (any, error) { return nil, nil }); err != nil {
		t.Fatalf("call after release: %v", err)
	}
	if _, err := Limit(0)(t.Context(), nil, nil, func(context.Context, any) (any, error) { return "ok", nil }); err != nil {
		t.Fatalf("Limit(0) must not limit: %v", err)
	}
}

// writeCert writes a self-signed certificate for localhost and returns the
// file names and a pool that trusts it.
func writeCert(t *testing.T, dir string, serial int64) (certFile, keyFile string, pool *x509.CertPool) {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	tmpl := &x509.Certificate{
		SerialNumber: big.NewInt(serial), Subject: pkix.Name{CommonName: "localhost"}, DNSNames: []string{"localhost"},
		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
		KeyUsage: x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
		BasicConstraintsValid: true, IsCA: true,
	}
	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
	if err != nil {
		t.Fatal(err)
	}
	keyDER, err := x509.MarshalPKCS8PrivateKey(key)
	if err != nil {
		t.Fatal(err)
	}
	certFile, keyFile = filepath.Join(dir, "tls.crt"), filepath.Join(dir, "tls.key")
	if err := os.WriteFile(certFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), 0o600); err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(keyFile, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: keyDER}), 0o600); err != nil {
		t.Fatal(err)
	}
	cert, _ := x509.ParseCertificate(der)
	pool = x509.NewCertPool()
	pool.AddCert(cert)
	return certFile, keyFile, pool
}

func TestTLSConfigReloads(t *testing.T) {
	dir := t.TempDir()
	certFile, keyFile, _ := writeCert(t, dir, 1)
	cfg, err := TLSConfig(certFile, keyFile, "")
	if err != nil {
		t.Fatal(err)
	}
	if cfg.MinVersion != tls.VersionTLS13 {
		t.Errorf("MinVersion = %x, want TLS 1.3", cfg.MinVersion)
	}
	serial := func() int64 {
		c, err := cfg.GetCertificate(nil)
		if err != nil {
			t.Fatal(err)
		}
		leaf, _ := x509.ParseCertificate(c.Certificate[0])
		return leaf.SerialNumber.Int64()
	}
	if got := serial(); got != 1 {
		t.Fatalf("serial = %d, want 1", got)
	}
	writeCert(t, dir, 2)
	future := time.Now().Add(time.Minute)
	if err := os.Chtimes(certFile, future, future); err != nil {
		t.Fatal(err)
	}
	if got := serial(); got != 2 {
		t.Fatalf("after rotation serial = %d, want 2", got)
	}
	if err := os.WriteFile(certFile, []byte("broken"), 0o600); err != nil {
		t.Fatal(err)
	}
	if got := serial(); got != 2 {
		t.Fatalf("a broken rotation must keep the old certificate, got serial %d", got)
	}
}

func TestTLSConfigErrors(t *testing.T) {
	dir := t.TempDir()
	if _, err := TLSConfig(filepath.Join(dir, "missing.crt"), filepath.Join(dir, "missing.key"), ""); err == nil {
		t.Error("missing key pair accepted")
	}
	certFile, keyFile, _ := writeCert(t, dir, 1)
	bad := filepath.Join(dir, "ca.pem")
	if err := os.WriteFile(bad, []byte("not a certificate"), 0o600); err != nil {
		t.Fatal(err)
	}
	if _, err := TLSConfig(certFile, keyFile, bad); err == nil {
		t.Error("invalid client CA accepted")
	}
	if _, err := TLSConfig(certFile, keyFile, filepath.Join(dir, "missing-ca.pem")); err == nil {
		t.Error("missing client CA accepted")
	}
	cfg, err := TLSConfig(certFile, keyFile, certFile)
	if err != nil {
		t.Fatalf("mTLS config: %v", err)
	}
	if cfg.ClientAuth != tls.RequireAndVerifyClientCert {
		t.Errorf("client auth = %v, want RequireAndVerifyClientCert", cfg.ClientAuth)
	}
}

// serve starts s on an in-memory listener and returns a client connection.
func serve(t *testing.T, s *Server, creds credentials.TransportCredentials) *grpc.ClientConn {
	t.Helper()
	lis := bufconn.Listen(1 << 20)
	go func() { _ = s.Serve(lis) }()
	conn, err := grpc.NewClient("passthrough:///localhost",
		grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) { return lis.DialContext(ctx) }),
		grpc.WithTransportCredentials(creds),
	)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = conn.Close() })
	return conn
}

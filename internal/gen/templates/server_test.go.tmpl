func healthOf(t *testing.T, conn *grpc.ClientConn, service string) healthpb.HealthCheckResponse_ServingStatus {
	t.Helper()
	resp, err := healthpb.NewHealthClient(conn).Check(t.Context(), &healthpb.HealthCheckRequest{Service: service})
	if err != nil {
		t.Fatalf("health check %q: %v", service, err)
	}
	return resp.GetStatus()
}

func TestHealthAndShutdown(t *testing.T) {
	s := New(discard, pb.Unimplemented{{.ServiceName}}Server{}, Options{RequestTimeout: time.Second, MaxInFlight: 10, MaxConnectionAge: time.Minute})
	conn := serve(t, s, insecure.NewCredentials())
	if _, ok := s.GetServiceInfo()[pb.{{.ServiceName}}_ServiceDesc.ServiceName]; !ok {
		t.Fatal("the API service is not registered")
	}
	for _, svc := range []string{"", pb.{{.ServiceName}}_ServiceDesc.ServiceName, LivenessService} {
		if got := healthOf(t, conn, svc); got != healthpb.HealthCheckResponse_SERVING {
			t.Fatalf("%q: status = %v, want SERVING", svc, got)
		}
	}
	// During the drain delay the server still answers, but reports NOT_SERVING
	// so that load balancers stop sending it new calls.
	done := make(chan struct{})
	go func() {
		s.Shutdown(300*time.Millisecond, time.Second)
		close(done)
	}()
	deadline := time.Now().Add(250 * time.Millisecond)
	for healthOf(t, conn, "") != healthpb.HealthCheckResponse_NOT_SERVING {
		if time.Now().After(deadline) {
			t.Fatal("health did not report NOT_SERVING during the drain")
		}
		time.Sleep(5 * time.Millisecond)
	}
	time.Sleep(50 * time.Millisecond)
	if got := healthOf(t, conn, ""); got != healthpb.HealthCheckResponse_NOT_SERVING {
		t.Fatalf("the server must keep answering during the drain, got %v", got)
	}
	<-done
}

func TestWatchStore(t *testing.T) {
	s := New(discard, pb.Unimplemented{{.ServiceName}}Server{}, Options{})
	conn := serve(t, s, insecure.NewCredentials())
	defer s.Shutdown(0, time.Second)
	var failing atomic.Bool
	failing.Store(true)
	ping := func(context.Context) error {
		if failing.Load() {
			return errors.New("connection refused")
		}
		return nil
	}
	ctx, cancel := context.WithCancel(t.Context())
	done := make(chan struct{})
	go func() {
		s.WatchStore(ctx, ping, 5*time.Millisecond)
		close(done)
	}()
	waitFor := func(want healthpb.HealthCheckResponse_ServingStatus) {
		t.Helper()
		for range 200 {
			if healthOf(t, conn, "") == want {
				return
			}
			time.Sleep(5 * time.Millisecond)
		}
		t.Fatalf("readiness never became %v", want)
	}
	waitFor(healthpb.HealthCheckResponse_NOT_SERVING)
	if got := healthOf(t, conn, LivenessService); got != healthpb.HealthCheckResponse_SERVING {
		t.Fatalf("liveness = %v while the store is down, want SERVING", got)
	}
	failing.Store(false)
	waitFor(healthpb.HealthCheckResponse_SERVING)
	cancel()
	<-done
}

func TestTLSServing(t *testing.T) {
	certFile, keyFile, pool := writeCert(t, t.TempDir(), 1)
	cfg, err := TLSConfig(certFile, keyFile, "")
	if err != nil {
		t.Fatal(err)
	}
	s := New(discard, pb.Unimplemented{{.ServiceName}}Server{}, Options{TLS: cfg})
	defer s.Shutdown(0, time.Second)
	conn := serve(t, s, credentials.NewTLS(&tls.Config{RootCAs: pool, ServerName: "localhost", MinVersion: tls.VersionTLS13}))
	if got := healthOf(t, conn, ""); got != healthpb.HealthCheckResponse_SERVING {
		t.Fatalf("status over TLS = %v, want SERVING", got)
	}
}

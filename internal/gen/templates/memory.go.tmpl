// Memory is a thread-safe in-memory Store. Records are cloned on the way in
// and out, so callers never share memory with the store. Data is lost when
// the process exits: use it for development and tests.
type Memory struct {
	mu sync.RWMutex
{{- range .Entities}}
	{{.PluralVar}}    map[string]*pb.{{.Name}}
	{{.PluralVar}}IDs []string // sorted
{{- end}}
}

var _ Store = (*Memory)(nil)

// NewMemory returns an empty in-memory store.
func NewMemory() *Memory {
	return &Memory{
{{- range .Entities}}
		{{.PluralVar}}: make(map[string]*pb.{{.Name}}),
{{- end}}
	}
}

// Ping implements Store; the in-memory store is always ready.
func (m *Memory) Ping(context.Context) error { return nil }

// page returns up to limit ids from the sorted ids that sort after after.
func page(ids []string, after string, limit int) []string {
	i, found := slices.BinarySearch(ids, after)
	if found {
		i++
	}
	return ids[i:min(i+max(limit, 0), len(ids))]
}

// Create{{.Name}} implements {{.Name}}Repository.
func (m *Memory) Create{{.Name}}(_ context.Context, {{.Var}} *pb.{{.Name}}) (*pb.{{.Name}}, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	if _, ok := m.{{.PluralVar}}[{{.Var}}.GetId()]; ok {
		return nil, fmt.Errorf("{{.Lower}} %q: %w", {{.Var}}.GetId(), ErrAlreadyExists)
	}
{{- if .Unique}}
	if err := m.check{{.Name}}Unique({{.Var}}); err != nil {
		return nil, err
	}
{{- end}}
	m.{{.PluralVar}}[{{.Var}}.GetId()] = proto.Clone({{.Var}}).(*pb.{{.Name}})
	i, _ := slices.BinarySearch(m.{{.PluralVar}}IDs, {{.Var}}.GetId())
	m.{{.PluralVar}}IDs = slices.Insert(m.{{.PluralVar}}IDs, i, {{.Var}}.GetId())
	return proto.Clone({{.Var}}).(*pb.{{.Name}}), nil
}

// Get{{.Name}} implements {{.Name}}Repository.
func (m *Memory) Get{{.Name}}(_ context.Context, id string) (*pb.{{.Name}}, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()
	{{.Var}}, ok := m.{{.PluralVar}}[id]
	if !ok {
		return nil, fmt.Errorf("{{.Lower}} %q: %w", id, ErrNotFound)
	}
	return proto.Clone({{.Var}}).(*pb.{{.Name}}), nil
}

// List{{.Plural}} implements {{.Name}}Repository.
func (m *Memory) List{{.Plural}}(_ context.Context, after string, limit int) ([]*pb.{{.Name}}, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()
	ids := page(m.{{.PluralVar}}IDs, after, limit)
	out := make([]*pb.{{.Name}}, 0, len(ids))
	for _, id := range ids {
		out = append(out, proto.Clone(m.{{.PluralVar}}[id]).(*pb.{{.Name}}))
	}
	return out, nil
}

// Update{{.Name}} implements {{.Name}}Repository.
func (m *Memory) Update{{.Name}}(_ context.Context, id string, mutate func(*pb.{{.Name}}) error) (*pb.{{.Name}}, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	cur, ok := m.{{.PluralVar}}[id]
	if !ok {
		return nil, fmt.Errorf("{{.Lower}} %q: %w", id, ErrNotFound)
	}
	next := proto.Clone(cur).(*pb.{{.Name}})
	if err := mutate(next); err != nil {
		return nil, err
	}
	next.Id = id
{{- if .Unique}}
	if err := m.check{{.Name}}Unique(next); err != nil {
		return nil, err
	}
{{- end}}
	m.{{.PluralVar}}[id] = next
	return proto.Clone(next).(*pb.{{.Name}}), nil
}

// Delete{{.Name}} implements {{.Name}}Repository.
func (m *Memory) Delete{{.Name}}(_ context.Context, id string) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	if _, ok := m.{{.PluralVar}}[id]; !ok {
		return fmt.Errorf("{{.Lower}} %q: %w", id, ErrNotFound)
	}
	delete(m.{{.PluralVar}}, id)
	if i, found := slices.BinarySearch(m.{{.PluralVar}}IDs, id); found {
		m.{{.PluralVar}}IDs = slices.Delete(m.{{.PluralVar}}IDs, i, i+1)
	}
	return nil
}
{{- if .Unique}}

// check{{.Name}}Unique returns ErrAlreadyExists if another {{.Lower}} holds one
// of x's unique values. The caller must hold m.mu.
func (m *Memory) check{{.Name}}Unique(x *pb.{{.Name}}) error {
	for id, other := range m.{{.PluralVar}} {
		if id == x.GetId() {
			continue
		}
{{- range .Unique}}
		if v := x.Get{{.GoName}}(); v != "" && other.Get{{.GoName}}() == v {
			return fmt.Errorf("{{$e.Lower}} with {{.Name}} %q: %w", v, ErrAlreadyExists)
		}
{{- end}}
	}
	return nil
}

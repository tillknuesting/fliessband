// Update{{.Name}} implements {{$.ServiceName}}.Update{{.Name}}. Only the fields
// named in update_mask change; fields named in the mask but unset are cleared.
func (s *Server) Update{{.Name}}(ctx context.Context, req *pb.Update{{.Name}}Request) (*pb.Update{{.Name}}Response, error) {
	in := req.Get{{.GoField}}()
	if in.GetId() == "" {
		return nil, status.Error(codes.InvalidArgument, "{{.Snake}}.id: is required")
	}
	paths := req.GetUpdateMask().GetPaths()
	if len(paths) == 0 {
		paths = {{.Var}}MutableFields
	}
	for _, p := range paths {
		if _, ok := {{.Var}}Setters[p]; !ok {
			return nil, status.Errorf(codes.InvalidArgument, "update_mask: field %q cannot be updated", p)
		}
	}
	updated, err := s.store.Update{{.Name}}(ctx, in.GetId(), func(cur *pb.{{.Name}}) error {
		for _, p := range paths {
			{{.Var}}Setters[p](cur, in)
		}
		cur.UpdateTime = timestamppb.New(s.now())
		return validate{{.Name}}(cur, "{{.Snake}}.")
	})
	if err != nil {
		return nil, s.toStatus(ctx, err)
	}
	return &pb.Update{{.Name}}Response{ {{.GoField}}: updated}, nil
}

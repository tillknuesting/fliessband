// List{{.Plural}} implements {{.Name}}Repository.
func (p *Postgres) List{{.Plural}}(ctx context.Context, after string, limit int) ([]*pb.{{.Name}}, error) {
	rows, err := p.pool.Query(ctx, `SELECT `+{{.Var}}Columns+` FROM {{.Table}} WHERE "id" > $1 ORDER BY "id" LIMIT $2`, after, max(limit, 0))
	if err != nil {

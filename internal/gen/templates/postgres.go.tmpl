	return pgx.CollectRows(rows, func(row pgx.CollectableRow) (*pb.{{.Name}}, error) { return scan{{.Name}}(row) })
}

// Update{{.Name}} implements {{.Name}}Repository. The row stays locked while
// mutate runs, so concurrent updates of one {{.Lower}} cannot lose writes.
func (p *Postgres) Update{{.Name}}(ctx context.Context, id string, mutate func(*pb.{{.Name}}) error) (*pb.{{.Name}}, error) {
	var out *pb.{{.Name}}
	err := pgx.BeginFunc(ctx, p.pool, func(tx pgx.Tx) error {
		cur, err := scan{{.Name}}(tx.QueryRow(ctx, `SELECT `+{{.Var}}Columns+` FROM {{.Table}} WHERE "id" = $1 FOR UPDATE`, id))
		if errors.Is(err, pgx.ErrNoRows) {
			return fmt.Errorf("{{.Lower}} %q: %w", id, ErrNotFound)
		}
		if err != nil {
			return err
		}
		if err := mutate(cur); err != nil {
			return err
		}
		cur.Id = id
		row := tx.QueryRow(ctx, `UPDATE {{.Table}} SET {{.SQLSets}} WHERE "id" = $1 RETURNING `+{{.Var}}Columns, {{.Var}}Args(cur)...)
		if out, err = scan{{.Name}}(row); err != nil {
			return {{.Var}}Error(err, cur)
		}
		return nil
	})
	if err != nil {
		return nil, err
	}
	return out, nil
}

// Delete{{.Name}} implements {{.Name}}Repository.
func (p *Postgres) Delete{{.Name}}(ctx context.Context, id string) error {
	tag, err := p.pool.Exec(ctx, `DELETE FROM {{.Table}} WHERE "id" = $1`, id)
	if err != nil {
		return err
	}
	if tag.RowsAffected() == 0 {
		return fmt.Errorf("{{.Lower}} %q: %w", id, ErrNotFound)
	}
	return nil
}

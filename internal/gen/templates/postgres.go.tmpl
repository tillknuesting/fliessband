func (p *Postgres) Get{{.Name}}(ctx context.Context, id string) (*pb.{{.Name}}, error) {
	x, err := scan{{.Name}}(p.pool.QueryRow(ctx, `SELECT `+{{.Var}}Columns+` FROM {{.Table}} WHERE "id" = $1`, id))

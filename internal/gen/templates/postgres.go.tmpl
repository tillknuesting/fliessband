// timeOrNil converts a proto timestamp into a nullable query argument.
func timeOrNil(ts *timestamppb.Timestamp) *time.Time {
	if ts == nil {
		return nil
	}
	t := ts.AsTime()
	return &t
}

{{- if index .PGHelpers "time"}}

// timeToProto converts a nullable column back into a proto timestamp.
func timeToProto(t *time.Time) *timestamppb.Timestamp {
	if t == nil {
		return nil
	}
	return timestamppb.New(*t)
}
{{- end}}
{{- if index .PGHelpers "orEmpty"}}

// orEmpty turns nil into an empty slice: NOT NULL array and bytea columns
// reject the NULL that pgx sends for a nil slice.
func orEmpty[T any](s []T) []T {
	if s == nil {
		return []T{}
	}
	return s
}
{{- end}}
{{- if index .PGHelpers "times"}}

func timesFromProto(ts []*timestamppb.Timestamp) []time.Time {
	out := make([]time.Time, len(ts))
	for i, t := range ts {
		out[i] = t.AsTime()
	}
	return out
}

func timesToProto(ts []time.Time) []*timestamppb.Timestamp {
	if len(ts) == 0 {
		return nil
	}
	out := make([]*timestamppb.Timestamp, len(ts))
	for i, t := range ts {
		out[i] = timestamppb.New(t)
	}
	return out
}
{{- end}}
{{- if index .PGHelpers "uint32s"}}

func uint32sToInt64s(v []uint32) []int64 {
	out := make([]int64, len(v))
	for i, x := range v {
		out[i] = int64(x)
	}
	return out
}

func int64sToUint32s(v []int64) []uint32 {
	if len(v) == 0 {
		return nil
	}
	out := make([]uint32, len(v))
	for i, x := range v {
		out[i] = uint32(min(max(x, 0), math.MaxUint32))
	}
	return out
}

// Server implements pb.{{.ServiceName}}Server.
type Server struct {
	pb.Unimplemented{{.ServiceName}}Server

	store store.Store
	log   *slog.Logger
	now   func() time.Time
}

// New returns a Server backed by the given store.
func New(st store.Store, log *slog.Logger) *Server {
	return &Server{store: st, log: log, now: now}
}

// now returns the current time at the microsecond precision that
// PostgreSQL stores, so responses look the same with either store.
func now() time.Time { return time.Now().UTC().Truncate(time.Microsecond) }

const (
	defaultPageSize = 50
	maxPageSize     = 1000
	maxTokenID      = 256
)

// pageBounds validates paging parameters and returns the id to continue
// after and the page size.
func pageBounds(size int32, token string) (after string, limit int, err error) {
	var v violations
	if size < 0 {
		v.add("page_size", "must not be negative")
	}
	limit = min(max(int(size), 0), maxPageSize)
	if limit == 0 {
		limit = defaultPageSize
	}
	if token != "" {
		var derr error
		if after, derr = decodePageToken(token); derr != nil {
			v.add("page_token", derr.Error())
		}
	}
	return after, limit, v.err()
}

// encodePageToken returns an opaque token that continues after the given id.
func encodePageToken(after string) string {
	return base64.RawURLEncoding.EncodeToString([]byte("k" + after))
}

func decodePageToken(token string) (string, error) {
	b, err := base64.RawURLEncoding.Strict().DecodeString(token)
	if err != nil || len(b) < 2 || len(b) > maxTokenID+1 || b[0] != 'k' {
		return "", errors.New("malformed page token")
	}
	// The decoder skips \r and \n, so compare with the canonical encoding:
	// only tokens this server issued are accepted.
	if encodePageToken(string(b[1:])) != token {
		return "", errors.New("malformed page token")
	}
	return string(b[1:]), nil
}

// nextPage trims items fetched with limit+1 to limit and returns the token
// for the next page, or "" if this is the last one.
func nextPage[T interface{ GetId() string }](items []T, limit int) ([]T, string) {
	if len(items) <= limit {
		return items, ""
	}
	items = items[:limit]
	return items, encodePageToken(items[limit-1].GetId())
}

// TestRules checks every RPC against every kind of caller. The expected
// codes were derived from the spec by the generator, not from Rules.
func TestRules(t *testing.T) {
{{- if .Auth.JWT}}
	idp := newIDP(t)
	a := authorizer(t, idp)
	a.cfg.MTLSIdentity = MTLSIdentity
{{- else}}
	var idp any
	a := New(t.Context(), Config{MTLSIdentity: true}, discard)
{{- end}}
	tests := []struct {
		method, caller string
		creds          bool
		roles          []string
		want           codes.Code
	}{
{{- range .Auth.Cases}}
		{ {{- printf "%q" .Method}}, {{printf "%q" .Caller}}, {{.Token}}, {{.Roles}}, {{.Code -}} },
{{- end}}
	}
	for _, tt := range tests {
		t.Run(tt.method+"/"+tt.caller, func(t *testing.T) {
			ctx := t.Context()
			if tt.creds {
				ctx = withCredentials(t, ctx, idp, tt.roles)
			}
			code, p := call(ctx, a, tt.method)
			if code != tt.want {
				t.Fatalf("got %v, want %v", code, tt.want)
			}
			switch {
			case code == codes.OK && tt.creds && p == nil:
				t.Error("the handler did not get the caller")
			case !tt.creds && p != nil:
				t.Errorf("an anonymous call reached the handler as %+v", p)
			}
		})
	}
}

func TestStreamInterceptor(t *testing.T) {
{{- if .Auth.JWT}}
	idp := newIDP(t)
	a := authorizer(t, idp)
{{- else}}
	var idp any
	a := New(t.Context(), Config{MTLSIdentity: true}, discard)
{{- end}}
	const method = "/other.v1.Other/Stream" // not in Rules: the default applies
	if code, p := stream(t.Context(), a, method); code != {{if eq .Auth.DefaultKind "deny"}}codes.PermissionDenied{{else if eq .Auth.DefaultKind "public"}}codes.OK{{else}}codes.Unauthenticated{{end}} || p != nil {
		t.Errorf("anonymous stream: %v, %+v", code, p)
	}
	code, p := stream(withCredentials(t, t.Context(), idp, nil), a, method)
	if code != {{if eq .Auth.DefaultKind "deny"}}codes.PermissionDenied{{else}}codes.OK{{end}} {
		t.Fatalf("stream with credentials: %v", code)
	}
	if code == codes.OK && p == nil {
		t.Error("the stream handler did not get the caller")
	}
}

// peerContext returns a context whose peer presented the given verified
// certificate chain, as gRPC reports a client certificate after mTLS.
func peerContext(ctx context.Context, chain ...*x509.Certificate) context.Context {
	var chains [][]*x509.Certificate
	if len(chain) > 0 {
		chains = [][]*x509.Certificate{chain}
	}
	return peer.NewContext(ctx, &peer.Peer{AuthInfo: credentials.TLSInfo{State: tls.ConnectionState{VerifiedChains: chains}}})
}

func spiffeCert() *x509.Certificate {
	return &x509.Certificate{
		Subject: pkix.Name{CommonName: "billing"},
		URIs:    []*url.URL{ {Scheme: "spiffe", Host: "example.org", Path: "/billing"} },
	}
}

func TestMTLSIdentity(t *testing.T) {
	on := New(t.Context(), Config{MTLSIdentity: true}, discard)
	off := New(t.Context(), Config{}, discard)
	tests := []struct {
		name string
		a    *Authorizer
		ctx  context.Context
		want string // subject, "" for anonymous
	}{
		{"URI SAN wins", on, peerContext(t.Context(), spiffeCert()), "spiffe://example.org/billing"},
		{"common name", on, peerContext(t.Context(), &x509.Certificate{Subject: pkix.Name{CommonName: "billing"} }), "billing"},
		{"no name", on, peerContext(t.Context(), &x509.Certificate{}), ""},
		{"no verified chain", on, peerContext(t.Context()), ""},
		{"no peer", on, t.Context(), ""},
		{"switched off", off, peerContext(t.Context(), spiffeCert()), ""},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			p, err := tt.a.authenticate(tt.ctx)
			if err != nil {
				t.Fatal(err)
			}
			switch {
			case tt.want == "" && p != nil:
				t.Fatalf("got principal %+v, want anonymous", p)
			case tt.want != "" && (p == nil || p.Subject != tt.want || p.Source != "mtls" || len(p.Roles) != 0):
				t.Fatalf("got %+v, want subject %q from mtls without roles", p, tt.want)
			}
		})
	}
}

func TestPrincipal(t *testing.T) {
	var none *Principal
	if none.HasRole("x") || none.HasAnyRole("x") {
		t.Error("a nil principal has no roles")
	}
	p := &Principal{Subject: "u", Roles: []string{"a", "b"} }
	if !p.HasRole("b") || p.HasRole("c") || !p.HasAnyRole("c", "a") || p.HasAnyRole("c", "d") || p.HasAnyRole() {
		t.Errorf("role checks wrong for %+v", p)
	}
	if _, ok := FromContext(t.Context()); ok {
		t.Error("an empty context has no principal")
	}
	if _, ok := FromContext(NewContext(t.Context(), nil)); ok {
		t.Error("a nil principal is no principal")
	}
	if got, ok := FromContext(NewContext(t.Context(), p)); !ok || got != p {
		t.Errorf("FromContext = %v, %v", got, ok)
	}
}

func TestRuleNames(t *testing.T) {
	for r, want := range map[*Rule]string{&Public: "public", &Authenticated: "authenticated", &Deny: "deny"} {
		if got := r.String(); got != want {
			t.Errorf("%v.String() = %q, want %q", *r, got, want)
		}
	}
	if got := Roles("a", "b").String(); got != "roles a, b" {
		t.Errorf("Roles(a, b) = %q", got)
	}
	if (Rule{}).String() != "authenticated" {
		t.Error("the zero rule must be authenticated, so a missing rule fails closed")
	}
}

// TestEveryRPCHasARule keeps the rule table and the API in step.
func TestEveryRPCHasARule(t *testing.T) {
	sd := pb.{{.ServiceName}}_ServiceDesc
	for _, m := range sd.Methods {
		if _, ok := Rules["/"+sd.ServiceName+"/"+m.MethodName]; !ok {
			t.Errorf("%s has no access rule", m.MethodName)
		}
	}
	if len(Rules) != len(sd.Methods)+len(sd.Streams) {
		t.Errorf("%d rules for %d RPCs", len(Rules), len(sd.Methods)+len(sd.Streams))
	}
	if got := RuleFor("/other.v1.Other/Call").String(); got != DefaultRule.String() {
		t.Errorf("unknown method gets %s, want the default %s", got, DefaultRule)
	}
	for _, m := range []string{"/grpc.health.v1.Health/Check", "/grpc.health.v1.Health/Watch",
		"/grpc.reflection.v1.ServerReflection/ServerReflectionInfo", "/grpc.reflection.v1alpha.ServerReflection/ServerReflectionInfo"} {
		if got := RuleFor(m).String(); got != "public" {
			t.Errorf("%s is %s, want public", m, got)
		}
	}
}

type fakeStream struct {
	grpc.ServerStream
	ctx context.Context
}

func (f fakeStream) Context() context.Context { return f.ctx }

// call runs the unary interceptor for method and returns the code and the
// principal the handler saw.
func call(ctx context.Context, a *Authorizer, method string) (codes.Code, *Principal) {
	var got *Principal
	_, err := a.Unary()(ctx, nil, &grpc.UnaryServerInfo{FullMethod: method}, func(ctx context.Context, _ any) (any, error) {
		got, _ = FromContext(ctx)
		return nil, nil
	})
	return status.Code(err), got
}

// stream runs the stream interceptor for method.
func stream(ctx context.Context, a *Authorizer, method string) (codes.Code, *Principal) {
	var got *Principal
	err := a.Stream()(nil, fakeStream{ctx: ctx}, &grpc.StreamServerInfo{FullMethod: method}, func(_ any, ss grpc.ServerStream) error {
		got, _ = FromContext(ss.Context())
		return nil
	})
	return status.Code(err), got
}

func TestNilAuthorizerFailsClosed(t *testing.T) {
	var a *Authorizer
	if code, _ := call(t.Context(), a, "/grpc.health.v1.Health/Check"); code != codes.OK {
		t.Errorf("health through a nil authorizer: %v", code)
	}
	for method, rule := range Rules {
		if rule.kind == kindPublic {
			continue
		}
		if code, _ := call(t.Context(), a, method); code == codes.OK {
			t.Errorf("%s (%s) is open through a nil authorizer", method, rule)
		}
	}
	if code, _ := stream(t.Context(), a, "/grpc.reflection.v1.ServerReflection/ServerReflectionInfo"); code != codes.OK {
		t.Errorf("reflection through a nil authorizer: %v", code)
	}
}

func TestBadAuthorizationHeaders(t *testing.T) {
	a := New(t.Context(), Config{MTLSIdentity: true}, discard)
	for name, vals := range map[string][]string{
		"basic scheme": {"Basic dXNlcg=="},
		"no scheme":    {"abc"},
		"empty bearer": {"Bearer "},
		"two headers":  {"Bearer a", "Bearer b"},
	} {
		t.Run(name, func(t *testing.T) {
			ctx := metadata.NewIncomingContext(peerContext(t.Context(), spiffeCert()), metadata.MD{"authorization": vals})
			if _, err := a.authenticate(ctx); status.Code(err) != codes.Unauthenticated {
				t.Fatalf("got %v, want Unauthenticated; bad credentials must never fall back to the certificate", err)
			}
		})
	}
}
